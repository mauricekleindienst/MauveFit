<?xml version="1.0" encoding="utf-8"?>
<!--
  Mauve Fit mark on the 108dp adaptive canvas: the heartbeat trace in the ocean accent whose two peaks form
  the M, fading out at both ends like a trace on a monitor. Sized to the
  adaptive-icon keylines: the mark stays inside the 66dp safe zone around the centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28.4,62.8 L39.6,62.8 L42.8,67.6 L47.6,40.4 L54,58 L60.4,40.4 L65.2,67.6 L68.4,62.8 L79.6,62.8">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28.4" android:startY="0"
                android:endX="79.6" android:endY="0">
                <item android:offset="0" android:color="#265FC4E8" />
                <item android:offset="0.22" android:color="#FF5FC4E8" />
                <item android:offset="0.78" android:color="#FF5FC4E8" />
                <item android:offset="1" android:color="#265FC4E8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
